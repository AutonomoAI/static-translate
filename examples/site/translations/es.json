{
  "locale": "es",
  "direction": "ltr",
  "pages": [
    {
      "source": "public/index.html",
      "output": "public/es/index.html",
      "replacements": [
        {
          "selector": "title",
          "source": "Example site",
          "target": "Sitio de ejemplo"
        },
        {
          "selector": "h1",
          "source": "Welcome",
          "target": "Bienvenido"
        },
        {
          "selector": ".copy",
          "source": "Hello",
          "target": "Hola"
        },
        {
          "selector": ".copy strong",
          "source": "world",
          "target": "mundo"
        },
        {
          "selector": "input",
          "attribute": "aria-label",
          "source": "Search",
          "target": "Buscar"
        },
        {
          "selector": "input",
          "attribute": "placeholder",
          "source": "Search",
          "target": "Buscar"
        }
      ]
    }
  ]
}
